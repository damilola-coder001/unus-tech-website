# Contact form forwarding (optional).
# If these are set, submissions to /api/contact are forwarded via the Resend API.
# If they are unset, submissions are validated and logged server-side only.
# See README.md ("Contact form") for details.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Public site URL, used for Open Graph / sitemap metadata.
# Leave unset until a custom domain exists: production on Vercel is detected
# automatically, and local dev falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com
