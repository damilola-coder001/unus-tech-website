# Contact form forwarding (optional).
# If these are set, submissions to /api/contact are forwarded via the Resend API.
# If they are unset, submissions are validated and logged server-side only.
# See README.md ("Contact form") for details.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Public site URL, used for Open Graph / sitemap metadata.
# Set this in Vercel (Project Settings → Environment Variables) to the
# production URL, e.g. NEXT_PUBLIC_SITE_URL=https://unus-tech-website.vercel.app
# It is baked in at build time: without it, a locally-built sitemap lists
# localhost URLs, which makes Search Console report "Couldn't fetch".
# NEXT_PUBLIC_SITE_URL=https://example.com
